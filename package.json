{
  "name": "eureka-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:grants": "pnpm --filter @eureka/shared exec tsx scripts/grants-table.ts",
    "local": "./scripts/local-dev.sh",
    "test:api": "docker compose --profile test up -d --wait testdb && TEST_PG_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55433 pnpm --filter @eureka/api test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
