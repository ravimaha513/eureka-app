# API
NODE_ENV=development
DATABASE_URL=postgres://eureka_app:change-me@127.0.0.1:5432/eureka
SESSION_SECRET=replace-with-64-random-characters-replace-with-64-random-chars
# dev = local sign-in picker (refused when NODE_ENV=production); google = Google Workspace OIDC
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=
PUBLIC_BASE_URL=http://localhost:5173
# Migrations (privileged connection)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/eureka
