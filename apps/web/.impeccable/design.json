  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action per view: carbon ink, inverts in dark.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Apply status</button>",
      "css": ".ds-btn{height:36px;padding:0 14px;border-radius:var(--r-md,6px);border:1px solid var(--line-strong,#d3d6df);background:var(--surface,#fff);color:var(--text,#171a2e);font:600 13.5px/1 \"Archivo Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;cursor:pointer}.ds-btn-primary{background:var(--pri-btn,#1f2342);border-color:var(--pri-btn,#1f2342);color:var(--on-pri,#fff)}.ds-btn-primary:hover{background:var(--pri-btn-hover,#31375f)}.ds-btn:focus-visible{outline:2px solid var(--pri,#1f2342);outline-offset:2px}.ds-btn:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every non-primary action; outlined surface with a leading line icon.",
      "html": "<button class=\"ds-btn2\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><path d=\"m7 10 5 5 5-5\"/><path d=\"M12 15V3\"/></svg>Export CSV</button>",
      "css": ".ds-btn2{height:36px;padding:0 14px;border-radius:var(--r-md,6px);border:1px solid var(--line-strong,#d3d6df);background:var(--surface,#fff);color:var(--text,#171a2e);font:600 13.5px/1 \"Archivo Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;cursor:pointer}.ds-btn2:hover{background:var(--hover,#f0f1f5)}.ds-btn2:focus-visible{outline:2px solid var(--pri,#1f2342);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Labelled input: field-stroke border, carbon focus with ink-wash halo.",
      "html": "<label class=\"ds-field\"><span>Search name</span><input placeholder=\"Candidate name\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:\"Archivo Variable\",system-ui,sans-serif}.ds-field span{font-weight:600;font-size:13px;color:var(--text2,#353a52)}.ds-field input{height:36px;width:220px;border-radius:var(--r-md,6px);border:1px solid var(--field-line,#868e9e);padding:0 10px;background:var(--surface,#fff);color:var(--text,#171a2e);font:400 14px \"Archivo Variable\",system-ui,sans-serif}.ds-field input::placeholder{color:var(--faint,#a0a5b3)}.ds-field input:focus{border-color:var(--pri,#1f2342);box-shadow:0 0 0 3px var(--pri-100,#e1e4ee);outline:none}"
    },
    {
      "name": "Status and Priority Chips",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Quiet tinted chips in plain words; P1 is carbon, never red.",
      "html": "<span class=\"ds-badge ds-ok\">Active</span> <span class=\"ds-badge ds-violet\">Open to all teams</span> <span class=\"ds-badge ds-warn\">On hold</span> <span class=\"ds-badge\">Bench</span> <span class=\"ds-prio ds-p1\">P1</span> <span class=\"ds-prio ds-p2\">P2</span> <span class=\"ds-prio\">P3</span>",
      "css": ".ds-badge{display:inline-block;padding:2px 7px;border-radius:var(--r-sm,4px);font:600 12px/1.35 \"Archivo Variable\",system-ui,sans-serif;background:var(--neutral-bg,#eff1f4);color:var(--neutral-fg,#474d5e)}.ds-ok{background:var(--ok-bg,#e7f5ec);color:var(--ok-fg,#17663a)}.ds-warn{background:var(--warn-bg,#fdf3e1);color:var(--warn-fg,#9a4d00)}.ds-violet{background:var(--violet-bg,#f1edfb);color:var(--violet-fg,#5b3aa8)}.ds-prio{font:700 11.5px \"Archivo Variable\",system-ui,sans-serif;font-variant-numeric:tabular-nums;padding:1px 6px;border-radius:var(--r-sm,4px);background:var(--neutral-bg,#eff1f4);color:var(--neutral-fg,#474d5e)}.ds-p1{background:var(--pri-btn,#1f2342);color:var(--on-pri,#fff)}.ds-p2{background:var(--warn-bg,#fdf3e1);color:var(--warn-fg,#9a4d00)}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "An active filter in the summary row, removable.",
      "html": "<span class=\"ds-fchip\">Status: Active<button class=\"ds-fx\" aria-label=\"Remove\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button></span>",
      "css": ".ds-fchip{display:inline-flex;align-items:center;gap:4px;padding:2px 2px 2px 8px;border-radius:var(--r-sm,4px);background:var(--surface,#fff);border:1px solid var(--line-strong,#d3d6df);color:var(--text,#171a2e);font:500 12px \"Archivo Variable\",system-ui,sans-serif}.ds-fx{border:0;background:none;color:var(--muted,#5f6675);width:24px;height:24px;border-radius:var(--r-sm,4px);display:inline-grid;place-items:center;padding:0;cursor:pointer}.ds-fx:hover{background:var(--line-strong,#d3d6df);color:var(--bad-fg,#b3261e)}.ds-fx:focus-visible{outline:2px solid var(--pri,#1f2342);outline-offset:2px}"
    },
    {
      "name": "Dense Table",
      "kind": "card",
      "refersTo": "table-head",
      "description": "Hairline card with condensed caps heads, 34px rows, highlighter selection, pinned row action.",
      "html": "<div class=\"ds-card\"><table class=\"ds-t\"><thead><tr><th>Candidate</th><th>Status</th><th>Pri</th><th class=\"n\">Days</th><th></th></tr></thead><tbody><tr aria-selected=\"true\"><td><b>Cand25 Test</b></td><td><span class=\"ds-badge ds-ok\">Active</span></td><td><span class=\"ds-prio ds-p1\">P1</span></td><td class=\"n\">7</td><td><button class=\"ds-btn2 sm\">View</button></td></tr><tr><td><b>Cand42 Test</b></td><td><span class=\"ds-badge\">Bench</span></td><td><span class=\"ds-prio\">P3</span></td><td class=\"n\">13</td><td><button class=\"ds-btn2 sm\">View</button></td></tr></tbody></table></div>",
      "css": ".ds-card{background:var(--surface,#fff);border:1px solid var(--line,#e3e5eb);border-radius:var(--r-lg,8px);overflow:hidden;font-family:\"Archivo Variable\",system-ui,sans-serif}.ds-t{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.ds-t th{font-size:11.5px;font-weight:650;font-stretch:82%;text-transform:uppercase;letter-spacing:.07em;color:var(--muted,#5f6675);text-align:left;padding:10px;background:var(--surface2,#f8f9fb);border-bottom:1px solid var(--line,#e3e5eb)}.ds-t td{padding:7px 10px;font-size:13.5px;color:var(--text2,#353a52);border-bottom:1px solid var(--line2,#eceef2)}.ds-t td b{color:var(--text,#171a2e)}.ds-t .n{text-align:right}.ds-t tbody tr:hover td{background:var(--surface2,#f8f9fb)}.ds-t tr[aria-selected=\"true\"] td{background:var(--sel,#fbf3d6)}.ds-t .ds-badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:12px;font-weight:600;background:var(--neutral-bg,#eff1f4);color:var(--neutral-fg,#474d5e)}.ds-t .ds-ok{background:var(--ok-bg,#e7f5ec);color:var(--ok-fg,#17663a)}.ds-t .ds-prio{font-size:11.5px;font-weight:700;padding:1px 6px;border-radius:4px;background:var(--neutral-bg,#eff1f4);color:var(--neutral-fg,#474d5e)}.ds-t .ds-p1{background:var(--pri-btn,#1f2342);color:var(--on-pri,#fff)}.ds-t .ds-btn2.sm{height:26px;padding:0 10px;border-radius:6px;border:1px solid var(--line-strong,#d3d6df);background:var(--surface,#fff);font:600 13px \"Archivo Variable\",system-ui,sans-serif;cursor:pointer}.ds-t .ds-btn2.sm:hover{background:var(--hover,#f0f1f5)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Carbon frame: condensed caps group label, items with line icons, signal-red rule on the current page.",
      "html": "<nav class=\"ds-side\"><div class=\"ds-brand\"><span class=\"ds-logo\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 14 14\" fill=\"currentColor\"><rect x=\"1\" y=\"1.5\" width=\"12\" height=\"2.4\" rx=\".5\"/><rect x=\"1\" y=\"5.8\" width=\"9\" height=\"2.4\" rx=\".5\"/><rect x=\"1\" y=\"10.1\" width=\"12\" height=\"2.4\" rx=\".5\"/></svg></span><span class=\"ds-wm\">Eureka<small>Staffing</small></span></div><div class=\"ds-sec\">Workspace</div><a class=\"ds-nav\" href=\"#\">Dashboard</a><a class=\"ds-nav\" href=\"#\" aria-current=\"page\">Hot List</a><a class=\"ds-nav\" href=\"#\">Candidates</a></nav>",
      "css": ".ds-side{background:var(--side-bg,#1b1e3a);color:var(--side-text,#c9cbdc);width:232px;padding:0 10px 12px;display:flex;flex-direction:column;gap:2px;font-family:\"Archivo Variable\",system-ui,sans-serif}.ds-brand{display:flex;align-items:center;gap:10px;height:60px;padding:3px 6px 0;color:#fff}.ds-logo{width:26px;height:26px;border-radius:var(--r-sm,4px);background:var(--brand,#c0262d);color:#fff;display:grid;place-items:center}.ds-wm{display:flex;flex-direction:column;line-height:1;font-stretch:78%;text-transform:uppercase;letter-spacing:.08em;font-size:17px;font-weight:750}.ds-wm small{font-size:10.5px;font-weight:500;color:var(--side-muted,#9a9db8);letter-spacing:.1em;margin-top:4px}.ds-sec{font-size:11px;color:var(--side-muted,#9a9db8);padding:14px 10px 4px;font-weight:650;font-stretch:78%;text-transform:uppercase;letter-spacing:.1em}.ds-nav{position:relative;display:flex;align-items:center;height:34px;padding:0 10px;border-radius:var(--r-md,6px);color:var(--side-text,#c9cbdc);text-decoration:none;font-size:14px;font-weight:500}.ds-nav:hover{background:var(--side-hover,#262a4c);color:#fff}.ds-nav[aria-current=\"page\"]{background:var(--side-current,#2c3058);color:#fff;font-weight:600}.ds-nav[aria-current=\"page\"]::before{content:\"\";position:absolute;left:-10px;top:7px;bottom:7px;width:3px;border-radius:0 2px 2px 0;background:var(--brand,#c0262d)}.ds-nav:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Underline Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "role=tab: underline on a hairline baseline; selected takes a 2px signal-red rule.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Overview</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Submissions</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Documents</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;border-bottom:1px solid var(--line,#e3e5eb)}.ds-tab{border:0;background:none;height:38px;padding:0 10px;margin-bottom:-1px;border-bottom:2px solid transparent;color:var(--muted,#5f6675);font:600 13px \"Archivo Variable\",system-ui,sans-serif;cursor:pointer}.ds-tab:hover{color:var(--text,#171a2e)}.ds-tab[aria-selected=\"true\"]{color:var(--text,#171a2e);border-bottom-color:var(--brand,#c0262d)}.ds-tab:focus-visible{outline:2px solid var(--pri,#1f2342);outline-offset:2px}"
    },
    {
      "name": "Bulk Bar",
      "kind": "custom",
      "refersTo": "bulk-bar",
      "description": "Highlighter strip that replaces the filter summary while rows are selected.",
      "html": "<div class=\"ds-bulk\"><span><b>2</b> candidates selected</span><select><option>Choose a status</option></select><button class=\"ds-bp\">Apply status</button><button class=\"ds-bs\">Clear selection</button></div>",
      "css": ".ds-bulk{display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--sel-line,#ecd889);border-radius:var(--r-md,6px);background:var(--sel,#fbf3d6);color:var(--text2,#353a52);font:400 14px \"Archivo Variable\",system-ui,sans-serif}.ds-bulk select{height:36px;width:150px;border-radius:6px;border:1px solid var(--field-line,#868e9e);background:var(--surface,#fff);padding:0 10px;font:inherit}.ds-bp,.ds-bs{height:36px;padding:0 14px;border-radius:6px;font:600 13.5px \"Archivo Variable\",system-ui,sans-serif;cursor:pointer}.ds-bp{background:var(--pri-btn,#1f2342);border:1px solid var(--pri-btn,#1f2342);color:var(--on-pri,#fff)}.ds-bp:hover{background:var(--pri-btn-hover,#31375f)}.ds-bs{background:var(--surface,#fff);border:1px solid var(--line-strong,#d3d6df);color:var(--text,#171a2e)}.ds-bs:hover{background:var(--hover,#f0f1f5)}.ds-bp:focus-visible,.ds-bs:focus-visible{outline:2px solid var(--pri,#1f2342);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Carbon Ledger",
    "overview": "Eureka is a working instrument for bench sales, and the list is the product. The world is a near-white neutral ground framed by a deep carbon-navy sidebar, with carbon-ink text, hairline rules, small corners and no resting shadows. One restrained signal red marks identity and place (the brand mark, the current-nav rule, the selected-tab underline) and otherwise means only \"error\". Everything else is ink, neutral tints and quiet status colour.\n\nDensity is the point. Users arrive from Google Sheets and judge the tool by how fast a filtered list appears, so screens put filters, active chips and the first table rows in the first viewport, rows run about 34px tall, and numbers sit in tabular figures. Archivo is the single family: normal width for everything you read, a condensed caps cut for column heads, sidebar section labels and the wordmark. Light and dark are both first-class; the carbon frame stays carbon in both, and the primary action inverts (carbon on light, near-white on dark).\n\nThe world rejects the previous indigo card-dashboard: gradient logo, soft shadows on every card, pill tabs and airy rows. Desktop and phone are distinct layouts, not one squeezed into the other: on phones, tables become stacked record cards, filters move into a bottom sheet, and the bulk bar docks to the bottom edge.",
    "keyCharacteristics": [
      "Carbon sidebar (232px, 64px collapsed) with off-white type, plus a white 56px top bar.",
      "One signal red, used only for identity, current place and errors.",
      "Carbon-ink primary actions; P1 priority is a carbon chip, not red.",
      "Hairline borders and tonal surfaces; elevation only for things that float.",
      "Archivo variable in two widths; condensed caps used only as labels.",
      "Status is a quiet tinted chip with plain words.",
      "Selection is a pale highlighter yellow, distinct from every status tint."
    ],
    "rules": [
      {
        "name": "The One Red Rule",
        "body": "Signal red marks the brand, the current place (nav rule, selected tab) and nothing else. Any other red on screen is an error state (`--bad-fg`). If a new element wants red, it wants carbon ink.",
        "section": "colors"
      },
      {
        "name": "The Carbon Primary Rule",
        "body": "The primary action is carbon ink, never red. A red button next to an error message reads as destructive.",
        "section": "colors"
      },
      {
        "name": "The Highlighter Rule",
        "body": "Selection is pale highlighter yellow (`--sel`). Selection never uses a status tint, the ink wash or red.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Condensed caps are for labels that name a column or a group: column heads, sidebar section labels, the wordmark. Never set a sentence, a value or a heading in them, and never put them above a heading as a lead-in.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Tables, counts, the pager and every numeric cell use tabular figures, and numeric columns align right.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Nothing that sits in the page flow has a shadow. If it does not float over content, it gets a hairline, not a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Small Corners Rule",
        "body": "No corner exceeds 8px, and controls, chips and tabs are never pill-shaped.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** reference tokens (`var(--brand)`, `var(--pri-btn)`, `var(--ok-bg)`) so both themes follow; never hard-code hex in components.",
      "**Do** keep signal red to the mark, the current-nav rule and the selected-tab underline; use `--bad-*` for errors.",
      "**Do** make the one primary action carbon ink (`--pri-btn`), and everything else secondary or ghost.",
      "**Do** show status as a tinted chip in plain words, and selection as the highlighter (`--sel`).",
      "**Do** set column heads and sidebar group labels in condensed caps (78–82% width, uppercase, tracked), and everything else in normal width.",
      "**Do** use tabular figures for every count and number, and right-align numeric columns.",
      "**Do** keep corners at 4 / 6 / 8px and separate surfaces with hairlines.",
      "**Do** design phones as their own layout: record cards, a filter bottom sheet, a docked bulk bar, 40–44px targets and 16px inputs."
    ],
    "donts": [
      "**Don't** use red for primary buttons, P1, badges or emphasis. It is identity, place or error.",
      "**Don't** put shadows on in-flow cards, tables, fields or buttons; `--shadow-lg` is for floating layers only.",
      "**Don't** use decorative gradients. The only gradient in the build is the hatched coverage-gap pattern, which shows data.",
      "**Don't** make tabs, chips or filter controls pill-shaped; circles are for avatars and the bell.",
      "**Don't** add lead-in labels above headings, or set sentences in condensed caps.",
      "**Don't** use shipping metaphors, ticket shapes, route codes or ornament.",
      "**Don't** use `--faint` for text that carries information; it is below 3:1.",
      "**Don't** fabricate metrics, logos or testimonials on the login panel or anywhere else."
    ]
  }
}