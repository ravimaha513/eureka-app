{
  "name": "@eureka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-dev.ts",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@eureka/shared": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "fastify": "^4.28.1",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/pg": "^8.23.1",
    "unplugin-swc": "^2.0.0"
  }
